{
  "name": "colors-lab-gh",
  "private": true,
  "version": "1.0.0",
  "description": "CI linting workflow for the Colors web application",
  "scripts": {
    "test": "jest --runInBand",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/css/**/*.css\"",
    "lint:js": "eslint public/js/code.js"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "htmlhint": "^1.7.1",
    "jest": "^30.3.0",
    "stylelint": "^16.25.0"
  }
}
